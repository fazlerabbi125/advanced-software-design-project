erDiagram
  DENIED_ACCESS_ATTEMPTS {
    int id PK
    uuid biometric_template_id
    string scanner_key_fingerprint
    string zone
    float confidence
    string reason
    datetime occurred_at
  }
  USERS ||--o| MEMBER_PROFILES : has
  USERS ||--o{ REFRESH_TOKENS : owns
  USERS ||--o{ MEMBERSHIPS : holds
  MEMBERSHIP_PLANS ||--o{ MEMBERSHIPS : "bought as"
  MEMBERSHIP_PLANS ||--o{ PLAN_ENTITLEMENTS : includes
  USERS ||--o{ BOOKINGS : makes
  TIMETABLE_SESSIONS ||--o{ BOOKINGS : "booked as"
  TIMETABLE_SESSIONS ||--o{ WAITLIST_ENTRIES : queues
  USERS ||--o{ WAITLIST_ENTRIES : joins
  USERS ||--o{ ACCESS_LOGS : generates
  USERS |o--o{ ACCESS_LOGS : "checks in (staff)"
  EQUIPMENT_UNITS |o--o{ TIMETABLE_SESSIONS : "slots on"
  EQUIPMENT_UNITS ||--o{ EQUIPMENT_FAULTS : has
  USERS ||--o{ EQUIPMENT_FAULTS : reports
  MEMBERSHIPS ||--o{ STRIPE_EVENTS : "activated by"
  MEMBERSHIPS |o--o{ MEMBERSHIPS : "renewed from"
