APP_NAME='BFS Gym API'
APP_HOST=0.0.0.0
ENABLE_DEBUG=true
APP_PORT=8000
DATABASE_DRIVER=postgresql+asyncpg
POSTGRES_HOST=postgres
POSTGRES_DB=bfs_gym
POSTGRES_USER=bfs_gym
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5432
CACHE_REDIS_PORT=6379
CACHE_REDIS_MAXMEMORY=256mb
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@bfs-gym.local
PGADMIN_DEFAULT_PASSWORD=replace-with-a-strong-local-password
CACHE_REDIS_URL=redis://cache-redis:6379/0
JWT_ACCESS_SECRET_KEY=replace-with-a-strong-access-token-secret
JWT_REFRESH_SECRET_KEY=replace-with-a-strong-refresh-token-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=bfs-gym-api
JWT_AUDIENCE=bfs-gym-clients
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=1814400
CORS_ALLOW_ORIGINS='["http://localhost:3000"]'
UPLOAD_ROOT=/app/uploads
BIOMETRIC_IMAGE_MAX_BYTES=5242880
VIP_ROOM_CAPACITY=8
SCANNER_DEVICE_KEYS='{"replace-with-a-long-random-sauna-door-key": "vip_sauna"}'

# Stripe (use test keys only — never commit real keys to the repository)
# 1. Get STRIPE_SECRET_KEY from https://dashboard.stripe.com/test/apikeys
# 2. Start the stripe-listener service:  docker compose --profile stripe up
# 3. Copy the "whsec_..." secret printed in the stripe-listener logs into STRIPE_WEBHOOK_SECRET.
# 4. Restart the api service to pick up the new value.
STRIPE_SECRET_KEY=sk_test_replace-with-your-stripe-test-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-signing-secret-from-stripe-cli-logs
STRIPE_SUCCESS_URL=http://localhost:8000/docs
STRIPE_CANCEL_URL=http://localhost:8000/docs
# Waitlist-offer expiry and no-show jobs; set false in all but one process if running several.
ENABLE_BOOKING_JOBS=true
